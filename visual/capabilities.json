{
    "dataRoles": [
        {
            "displayName": "Field Parameter",
            "name": "fieldParameter",
            "kind": "Grouping",
            "description": "Visible label column from the Field Parameter."
        },
        {
            "displayName": "Area / domain",
            "name": "domain",
            "kind": "Grouping",
            "description": "Optional top-level catalog grouping, such as Product, Customer, or Order."
        },
        {
            "displayName": "Group / level",
            "name": "group",
            "kind": "Grouping",
            "description": "Optional second-level catalog grouping, such as Geo or Commercial Line."
        },
        {
            "displayName": "Catalog order",
            "name": "catalogOrder",
            "kind": "Grouping",
            "description": "Optional numeric order used only to display catalog items."
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "fieldParameter": {
                        "min": 1,
                        "max": 1
                    },
                    "domain": {
                        "min": 0,
                        "max": 1
                    },
                    "group": {
                        "min": 0,
                        "max": 1
                    },
                    "catalogOrder": {
                        "min": 0,
                        "max": 1
                    }
                }
            ],
            "categorical": {
                "categories": {
                    "select": [
                        {
                            "for": {
                                "in": "fieldParameter"
                            }
                        },
                        {
                            "for": {
                                "in": "domain"
                            }
                        },
                        {
                            "for": {
                                "in": "group"
                            }
                        },
                        {
                            "for": {
                                "in": "catalogOrder"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 1000
                        }
                    }
                }
            }
        }
    ],
