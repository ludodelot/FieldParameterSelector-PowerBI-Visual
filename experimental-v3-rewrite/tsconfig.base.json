{
    "compilerOptions": {
        "allowJs": false,
        "target": "es6",
        "moduleResolution": "node",
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "lib": [
            "es2015",
            "dom"
        ]
    }
}
